  "_comment": "Edit this file to change what the portal offers. Then run: npm run build:catalog",
  "_updated": "2026-08-26",
  "sources": [
    { "id": "self",    "label": "This site",   "base": "", "mode": "self" },
    { "id": "gh",      "label": "GitHub (official)", "base": "https://github.com", "mode": "raw" },
    { "id": "ghproxy", "label": "Mirror A",  "base": "https://gh-proxy.com/", "mode": "prefix" },
    { "id": "ghproxy2","label": "Mirror B",  "base": "https://ghproxy.net/", "mode": "prefix" },
    { "id": "gofans",  "label": "Mirror C",  "base": "https://ghfast.top/", "mode": "prefix" }
  ],
  "apps": [
    {
      "id": "clash-verge",
      "name": "Clash Verge Rev",
      "tagline": "Recommended · desktop pick",
      "repo": "clash-verge-rev/clash-verge-rev",
      "os": ["windows", "macos", "linux"],
      "why": "mihomo core, full VLESS + REALITY support, the friendliest UI, one-click subscription import.",
      "files": [
        { "os": "windows", "label": "Windows x64 installer", "match": "^Clash\\.Verge_[0-9.]+_x64-setup\\.exe$", "primary": true },
        { "os": "windows", "label": "Windows ARM64", "match": "^Clash\\.Verge_[0-9.]+_arm64-setup\\.exe$" },
        { "os": "windows", "label": "Pre-Win10 / no WebView2", "match": "^Clash\\.Verge_[0-9.]+_x64_fixed_webview2-setup\\.exe$" },
        { "os": "macos",   "label": "macOS Apple silicon (M1–M4)", "match": "^Clash\\.Verge_[0-9.]+_aarch64\\.dmg$" },
        { "os": "macos",   "label": "macOS Intel", "match": "^Clash\\.Verge_[0-9.]+_x64\\.dmg$", "primary": true },
        { "os": "linux",   "label": "Linux .deb (Ubuntu/Debian)", "match": "^Clash\\.Verge_[0-9.]+_amd64\\.deb$", "primary": true },
        { "os": "linux",   "label": "Linux .rpm (Fedora/openSUSE)", "match": "^Clash\\.Verge-[0-9.]+-1\\.x86_64\\.rpm$" }
      ]
    },
    {
      "id": "hiddify",
      "name": "Hiddify",
      "tagline": "Cross-platform · simplest",
      "repo": "hiddify/hiddify-app",
      "os": ["windows", "macos", "linux", "android"],
      "why": "Free and open source, the most foolproof subscription import. If you're not sure what to install, install this. Note: the repo was renamed from hiddify-next to hiddify-app.",
      "files": [
        { "os": "windows", "label": "Windows x64 installer", "match": "^Hiddify-Windows-Setup-x64\\.exe$", "primary": true },
        { "os": "windows", "label": "Windows portable (no install)", "match": "^Hiddify-Windows-Portable-x64\\.zip$" },
        { "os": "macos",   "label": "macOS .dmg", "match": "^Hiddify-MacOS\\.dmg$", "primary": true },
        { "os": "linux",   "label": "Linux AppImage", "match": "^Hiddify-Linux-x64-AppImage\\.AppImage$" },
        { "os": "linux",   "label": "Linux .deb", "match": "^Hiddify-Debian-x64\\.deb$" },
        { "os": "android", "label": "Android arm64 (most phones)", "match": "^Hiddify-Android-arm64\\.apk$", "primary": true },
        { "os": "android", "label": "Android universal (older devices)", "match": "^Hiddify-Android-universal\\.apk$" }
      ]
    },
    {
      "id": "v2rayng",
      "name": "v2rayNG",
      "tagline": "Android pick",
      "repo": "2dust/v2rayNG",
      "os": ["android"],
      "why": "The most mature Android client, native Xray core, the most complete VLESS + REALITY support.",
      "files": [
        { "os": "android", "label": "arm64-v8a (phones from 2018 on)", "match": "^v2rayNG_[0-9.]+_arm64-v8a\\.apk$", "primary": true },
        { "os": "android", "label": "armeabi-v7a (older phones)", "match": "^v2rayNG_[0-9.]+_armeabi-v7a\\.apk$" },
        { "os": "android", "label": "x86_64 (emulator)", "match": "^v2rayNG_[0-9.]+_x86_64\\.apk$" },
        { "os": "android", "label": "F-Droid build arm64", "match": "^v2rayNG_[0-9.]+-fdroid_arm64-v8a\\.apk$" }
      ]
    },
    {
      "id": "v2rayn",
      "name": "v2rayN",
      "tagline": "Windows veteran",
      "repo": "2dust/v2rayN",
      "os": ["windows", "macos", "linux"],
      "why": "The most-used client on Windows, official Xray core. Note: recent versions are cross-platform, so files are named v2rayN-platform-arch.",
      "files": [
        { "os": "windows", "label": "Windows x64 desktop", "match": "^v2rayN-windows-64-desktop\\.zip$", "primary": true },
        { "os": "windows", "label": "Windows x64 standard", "match": "^v2rayN-windows-64\\.zip$" },
        { "os": "windows", "label": "Windows 32-bit", "match": "^v2rayN-windows-86-desktop\\.zip$" },
        { "os": "macos",   "label": "macOS Apple silicon", "match": "^v2rayN-macos-arm64\\.dmg$" },
        { "os": "macos",   "label": "macOS Intel", "match": "^v2rayN-macos-64\\.dmg$" },
        { "os": "linux",   "label": "Linux .deb", "match": "^v2rayN-linux-64\\.deb$" }
      ]
    },
    {
      "id": "clash-party",
      "name": "Clash Party",
      "tagline": "formerly mihomo-party",
      "repo": "mihomo-party-org/clash-party",
      "os": ["windows", "macos", "linux"],
      "why": "mihomo-party was renamed Clash Party. Bundles its own core and ships a Windows 7 build — use it for customers on old machines.",
      "files": [
        { "os": "windows", "label": "Windows 7 x64 (old machines)", "match": "^clash-party-win7-[0-9.]+-x64-setup\\.exe$", "primary": true },
        { "os": "windows", "label": "Windows 7 32-bit", "match": "^clash-party-win7-[0-9.]+-ia32-setup\\.exe$" },
        { "os": "windows", "label": "Windows x64 (Win10/11)", "match": "^clash-party-windows-[0-9.]+-x64-setup\\.exe$" },
        { "os": "macos",   "label": "macOS Apple silicon .pkg", "match": "^clash-party-macos-[0-9.]+-arm64\\.pkg$" },
        { "os": "macos",   "label": "macOS Intel .pkg", "match": "^clash-party-macos-[0-9.]+-x64\\.pkg$" },
        { "os": "linux",   "label": "Linux .deb", "match": "^clash-party-linux-[0-9.]+-amd64\\.deb$" }
      ]
    },
    {
      "id": "nekobox",
      "name": "NekoBox for Android",
      "tagline": "Android alternative",
      "repo": "MatsuriDayo/NekoBoxForAndroid",
      "os": ["android"],
      "why": "Dual sing-box/Xray cores, imports your exported yaml directly. Note: the desktop NekoRay repo is archived/unmaintained, but the Android build is still updated.",
      "files": [
        { "os": "android", "label": "arm64-v8a", "match": "^NekoBox-[0-9.]+-arm64-v8a\\.apk$", "primary": true },
        { "os": "android", "label": "armeabi-v7a (older phones)", "match": "^NekoBox-[0-9.]+-armeabi-v7a\\.apk$" }
      ]
    },
    {
      "id": "throne",
      "name": "Throne",
      "tagline": "sing-box desktop",
      "repo": "throneproj/Throne",
      "os": ["windows", "macos", "linux"],
      "why": "The community successor after NekoRay went unmaintained. Cross-platform, good REALITY support.",
      "files": [
        { "os": "windows", "label": "Windows universal installer", "match": "^Throne-[0-9.]+-windows-universal-installer\\.exe$", "primary": true },
        { "os": "windows", "label": "Windows 7/8 64-bit", "match": "^Throne-[0-9.]+-windowslegacy64\\.zip$" },
        { "os": "macos",   "label": "macOS Apple silicon", "match": "^Throne-[0-9.]+-macos-arm64\\.zip$" },
        { "os": "linux",   "label": "Linux amd64", "match": "^Throne-[0-9.]+-linux-amd64\\.zip$" }
      ]
    },
    {
      "id": "xray-core",
      "name": "Xray-core",
      "tagline": "Server / advanced users",
      "repo": "XTLS/Xray-core",
      "os": ["windows", "macos", "linux"],
      "why": "The server-side core itself, or for customers who run their own node. Ordinary customers don't need this.",
      "files": [
        { "os": "linux",   "label": "Linux amd64", "match": "^Xray-linux-64\\.zip$", "primary": true },
        { "os": "linux",   "label": "Linux arm64", "match": "^Xray-linux-arm64-v8a\\.zip$" },
        { "os": "macos",   "label": "macOS arm64", "match": "^Xray-macos-arm64-v8a\\.zip$" },
        { "os": "windows", "label": "Windows 64-bit", "match": "^Xray-windows-64\\.zip$" },
        { "os": "windows", "label": "Windows 7 64-bit", "match": "^Xray-win7-64\\.zip$" },
        { "os": "linux",   "label": "Checksum file Xray-linux-64.zip.dgst", "match": "^Xray-linux-64\\.zip\\.dgst$", "internal": true }
      ]
    }
  ],
  "ios": [
    { "id": "shadowrocket", "name": "Shadowrocket",   "price": "US$2.99", "appId": "932747118",  "updated": "maintained", "note": "Top iOS pick. Requires a non-China Apple ID — removed from the China App Store, so a China Apple ID won't find it.", "primary": true },
    { "id": "surge5",       "name": "Surge 5",        "price": "free + IAP", "appId": "1442620678", "updated": "2026-08-11", "note": "Most powerful, most actively updated. Complex rule engine — for technical users." },
    { "id": "stash",        "name": "Stash",          "price": "US$5.99", "appId": "1596063349", "updated": "2026-07-16", "note": "Clash ecosystem, the most flexible rules." },
    { "id": "quantumultx",  "name": "Quantumult X",   "price": "paid",    "appId": "1443988620", "updated": "maintained", "note": "Long-standing, good REALITY support." },
    { "id": "loon",         "name": "Loon",           "price": "US$4.99", "appId": "1373567447", "updated": "maintained", "note": "Long-standing and stable." },
    { "id": "karing",       "name": "Karing",         "price": "free",    "appId": "6472431552", "updated": "2026-08-12", "note": "Free + open source, sing-box core, native REALITY support. Best free option." },
    { "id": "v2box",        "name": "V2Box",          "price": "free",    "appId": "6446814690", "updated": "2026-08-17", "note": "Free, simple UI, good for non-technical users." },
    { "id": "streisand",    "name": "Streisand",      "price": "free",    "appId": "6450534064", "updated": "2026-07-14", "note": "Free alternative." },
    { "id": "hiddify-ios",  "name": "Hiddify (iOS)",  "price": "free",    "appId": "6596777532", "updated": "2026-02-19", "note": "One subscription across Android/iOS/desktop." }
  ]
